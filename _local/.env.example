# Copy this file to ".env" in this folder (_local/), then uncomment and fill in your values.
#
# --- Required for core workflow (upload, vibe, batch stills) ---
# Get a key: https://aistudio.google.com/apikey
# VITE_GEMINI_API_KEY=your_google_ai_studio_key_here
#
# --- Required only for Solo Upscale (fal.ai / Topaz) ---
# Get a key: https://fal.ai/dashboard/keys
# FAL_API_KEY=your_fal_key_here
#
# --- Optional: override default Gemini model ids (see src/lib/geminiConfig.ts) ---
# VITE_GEMINI_MODEL=gemini-3.1-pro-preview
# VITE_GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# VITE_GEMINI_SAFETY_MODE=relaxed
